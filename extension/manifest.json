{
  "manifest_version": 3,
  "name": "C2DPost Helper - Thailand Post API Bridge",
  "version": "1.1.0",
  "description": "ส่วนเสริมช่วยดึงหมายเลขบาร์โค้ด (PostOne) และช่วยกรอกข้อมูลเข้าสู่ระบบ DPost / e-AR สำหรับ C2DPost Web",
  "permissions": ["storage"],
  "host_permissions": [
    "https://postone.thailandpost.com/*",
    "https://dpost.thailandpost.com/*",
    "https://e-ar.thailandpost.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dpost.thailandpost.com/*",
        "https://e-ar.thailandpost.com/*"
      ],
      "js": ["external_autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
